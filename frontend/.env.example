# ============================================================
# Переменные окружения для frontend (Vite)
#
# В режиме разработки API проксируется через Vite (vite.config.ts),
# поэтому VITE_API_URL не требуется.
# В production API проксируется через Nginx (nginx.conf).
# ============================================================

# Базовый URL API (опционально, если не используется прокси)
# VITE_API_URL=/api
