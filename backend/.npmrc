# ============================================================
# Настройки npm для устойчивости к сетевым сбоям
# ============================================================
# Повышаем устойчивость к временным сетевым ошибкам (ECONNRESET),
# которые могут возникать при параллельной загрузке пакетов
# внутри Docker-контейнеров на macOS.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
